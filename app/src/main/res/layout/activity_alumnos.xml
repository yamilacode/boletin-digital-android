<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloAlumnos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo_alumnos"
        android:textAppearance="@style/Titulo.BoletinDigital" />

    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/cargando"
        android:textAppearance="@style/Subtitulo.BoletinDigital" />

    <Button
        android:id="@+id/btnNuevoAlumno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nuevo_alumno" />

    <ListView
        android:id="@+id/listaAlumnos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

</LinearLayout>
