<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_body"
    android:orientation="vertical">

    <!-- Encabezado Superior con Botón Volver -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Botón Volver -->
            <LinearLayout
                android:id="@+id/btnVolverAlumnos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Volver"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Volver"
                    android:textColor="@color/color_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvUsuarioRol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="SESIÓN ACTIVA"
                android:textColor="@color/color_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lista_cargada"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitulo_alumnos"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Barra de Búsqueda por Apellido, Nombre o DNI -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_main"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/etBuscarAlumno"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Buscar por apellido, nombre o DNI..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/ivLimpiarBusquedaAlumno"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Limpiar búsqueda"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_muted" />

                <ImageView
                    android:id="@+id/btnBuscarAlumnoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Buscar alumno"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/color_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Contenedor Principal de la Lista -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <!-- Lista de Alumnos con Tarjetas -->
        <ListView
            android:id="@+id/listaAlumnos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:paddingBottom="12dp"
            android:scrollbarThumbVertical="@color/border_main" />

        <!-- Indicador de Carga -->
        <ProgressBar
            android:id="@+id/pbCargandoAlumnos"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_primary"
            android:visibility="gone" />

        <!-- Mensaje de Estado / Vacío -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/cargando"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Barra Inferior de Acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuevoAlumno"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/color_primary"
            android:text="@string/nuevo_alumno"
            android:textColor="@color/bg_body"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:elevation="0dp" />
    </LinearLayout>

    <!-- BARRA DE NAVEGACIÓN INFERIOR -->
    <include layout="@layout/layout_footer_docente" />

</LinearLayout>
