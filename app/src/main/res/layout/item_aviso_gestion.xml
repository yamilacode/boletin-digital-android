<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_main"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Franja de Color Izquierda según Prioridad -->
        <View
            android:id="@+id/vFranjaPrioridadAviso"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/color_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTituloItemAviso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reunión General de Tutores"
                    android:textColor="@color/color_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFechaItemAviso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoy"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCategoriaItemAviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Categoría: Atención y Preceptoría"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvContenidoItemAviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Se convoca a los tutores de 4° año a la reunión informativa del día viernes a las 18:00 hs."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="@color/border_subtle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnEditarAvisoItem"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/color_badge_blue_bg"
                    android:clickable="true"
                    android:contentDescription="Editar aviso"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/color_primary" />

                <ImageView
                    android:id="@+id/btnEliminarAvisoItem"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/color_danger_bg"
                    android:clickable="true"
                    android:contentDescription="Eliminar aviso"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/color_danger" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>