<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_main"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Cabecera del Alumno -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/bg_surface">

                <TextView
                    android:id="@+id/tvInicialAlumno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="P"
                    android:textColor="@color/color_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreAlumno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLEININGER, URIEL LUCIANO"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDniAlumno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="DNI: 48763736"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvEstadoNotaItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/bg_surface"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Sin calificación cargada"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Acciones Rápidas: Editar (Lápiz) y Eliminar (Tachito) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnEditarNotaItem"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/color_badge_blue_bg"
                    android:clickable="true"
                    android:contentDescription="Editar calificación"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/color_primary" />

                <ImageView
                    android:id="@+id/btnEliminarNotaItem"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/color_danger_bg"
                    android:clickable="true"
                    android:contentDescription="Eliminar calificación"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/color_danger" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/border_main" />

        <!-- Fila de Calificación: Nota Numérica + Selector Conceptual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Campo Nota Numérica (1 a 10) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:hint="Nota"
                android:textColorHint="@color/text_muted"
                app:boxBackgroundColor="@color/bg_surface"
                app:boxStrokeColor="@color/color_primary"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/color_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotaNumerica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- Botones / Chips R.I.T.E. PBA (TEA / TEP / TED) -->
                <LinearLayout
                    android:id="@+id/layoutChipsPba"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnChipTea"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/bg_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="TEA"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnChipTep"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/bg_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="TEP"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnChipTed"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/bg_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="TED"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botones / Chips Formosa (SO / MB / B / R / I) -->
                <LinearLayout
                    android:id="@+id/layoutChipsFormosa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnChipSo"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/bg_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="SO"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnChipMb"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/bg_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="MB"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnChipB"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/bg_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnChipR"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/bg_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="R"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnChipI"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/bg_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="I"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Campo Opcional: Observación Pedagógica -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Observación pedagógica (opcional)"
            android:textColorHint="@color/text_muted"
            app:boxBackgroundColor="@color/bg_surface"
            app:boxStrokeColor="@color/border_main"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/color_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etObservacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="@color/text_main"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

